"calcularse: %s."

#: R/texts.R
msgid ""
"z: %2$s test of each coefficient against %1$s; p is one-sided. mokken does "
"not test the ratio BW."
msgstr ""
"z: prueba %2$s de cada coeficiente contra %1$s; p es unilateral. mokken no "
"contrasta la razón BW."

#: R/texts.R
msgid ""
"z: %2$s test of each coefficient against the lower bound %1$s; p is "
"one-sided (coefficient larger than the bound)."
msgstr ""
"z: prueba %2$s de cada coeficiente contra la cota inferior %1$s; p es "
"unilateral (coeficiente mayor que la cota)."

#: R/texts.R
msgid ""
"z: original Z test of each coefficient against zero (Mokken, 1971); p is "
"one-sided."
msgstr ""
"z: prueba Z original de cada coeficiente contra cero (Mokken, 1971); p es "
"unilateral."

