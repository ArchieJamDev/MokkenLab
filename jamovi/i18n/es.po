#: R/texts.R
msgid "Rest-score method: %d item(s) with serious violations (%s)."
msgstr "Método rest-score: %d ítem(s) con violaciones serias (%s)."

#: R/texts.R
msgid ""
"Rest-score method: items with serious violations of nonintersection (crit > "
"80) (%d): %s. Their item step response functions cross those of other items."
msgstr ""
"Método rest-score: ítems con violaciones serias de la no intersección (crit "
"> 80) (%d): %s. Las funciones de respuesta de sus pasos se cruzan con las de "
"otros ítems."

